{
  "name": "clipwise",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "sh -c 'if [ \"$(uname)\" = \"Darwin\" ]; then tauri dev --config src-tauri/tauri.macos.conf.json; else tauri dev; fi'",
    "tauri:dev:appstore": "tauri dev --config src-tauri/tauri.appstore.conf.json -- --no-default-features",
    "tauri:build": "sh -c 'if [ \"$(uname)\" = \"Darwin\" ]; then tauri build --config src-tauri/tauri.macos.conf.json; else tauri build; fi'",
    "tauri:build:appstore": "tauri build --config src-tauri/tauri.appstore.conf.json -- --no-default-features --features custom-protocol",
    "tauri:build-debug": "sh -c 'if [ \"$(uname)\" = \"Darwin\" ]; then tauri build --debug --config src-tauri/tauri.macos.conf.json; else tauri build --debug; fi'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit:rust": "./scripts/audit-rust.sh",
    "validate:release-notes": "./scripts/validate-release-notes.sh",
    "bump": "./scripts/bump-version.sh",
    "bump:patch": "./scripts/bump-version.sh patch",
    "bump:minor": "./scripts/bump-version.sh minor",
    "bump:major": "./scripts/bump-version.sh major",
    "prepare": "lefthook install",
    "gen-types": "cd src-tauri && TS_RS_EXPORT_DIR=../src/types/bindings cargo test --features ts export_bindings && cd .. && prettier --write src/types/bindings",
    "gen-types:check": "npm run gen-types && git diff --exit-code src/types/bindings"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.2"
  }
}
